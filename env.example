APP_BASE_URL=http://localhost:3000

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM=your-email@gmail.com

# Microsoft 365 / Outlook example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_USER=your-email@yourdomain.com
# SMTP_PASSWORD=your-mail-password-or-app-password
# SMTP_FROM=your-email@yourdomain.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Link status mail alerts
# Recipients can be one or more comma-separated email addresses.
MAIL_ALERTS_ENABLED=false
MAIL_ALERT_RECIPIENTS=
MAIL_ALERT_ON_RECOVERY=true
